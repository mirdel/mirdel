{
  "name": "@mirdel/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Mirdel - Next-generation AI workspace",
  "author": "Mirdel Team",
  "homepage": "https://www.mirdel.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirdel/mirdel.git"
  },
  "bugs": {
    "url": "https://github.com/mirdel/mirdel/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "predev": "pnpm run prepare:platform-runtime && pnpm run prepare:electron-native",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "release:target": "node ./scripts/release-desktop.mjs",
    "pack": "electron-vite build && pnpm run prepare:packaged-main-chunks && pnpm run prepare:platform-runtime && pnpm run prepare:electron-native && electron-builder --dir",
    "dist": "electron-vite build && pnpm run prepare:packaged-main-chunks && pnpm run prepare:platform-runtime && pnpm run prepare:electron-native && electron-builder",
    "dist:local": "cross-env RUNTIME_TARGET=darwin-arm64 ELECTRON_BUILDER_ARGS=\"--mac dmg --arm64\" CLEAN_UNPACKED_APP=true pnpm run release:target",
    "prepare:electron-native": "node ./scripts/ensure-electron-native.mjs",
    "prepare:packaged-main-chunks": "node ./scripts/prepare-packaged-main-chunks.mjs",
    "prepare:platform-runtime": "node ./scripts/prepare-platform-runtime.mjs",
    "prepare:model-server-runtime": "node ./scripts/prepare-model-server-runtime.mjs",
    "prepare:python-runtime": "node ./scripts/prepare-python-runtime.mjs",
    "prepare:sqlite-extension-runtime": "node ./scripts/prepare-sqlite-extension-runtime.mjs",
    "prepare:searxng-python-deps": "node ./scripts/install-searxng-python-deps.mjs",
    "prepare:searxng-python-deps:all": "node ./scripts/install-searxng-python-deps.mjs --all",
    "verify:sqlite-extension": "node ./scripts/verify-sqlite-extension.mjs",
    "lint": "echo \"(desktop) lint: TODO\"",
    "test:prepare-native": "node ./scripts/ensure-better-sqlite3-native.mjs",
    "test:prepare-runtime": "pnpm run prepare:sqlite-extension-runtime && pnpm run verify:sqlite-extension && pnpm run test:prepare-native",
    "test:data": "pnpm run test:prepare-runtime && vitest run --config vitest.data.config.ts",
    "test:store": "pnpm run test:prepare-runtime && vitest run --config vitest.store.config.ts",
    "test:service": "pnpm run test:prepare-runtime && vitest run --config vitest.service.config.ts",
    "test:router": "pnpm run test:prepare-runtime && vitest run --config vitest.router.config.ts",
    "test": "pnpm run test:prepare-runtime && vitest run",
    "test:watch": "vitest",
    "format": "echo \"(desktop) format: TODO\""
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^1.0.10",
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/bytedance": "^1.0.4",
    "@ai-sdk/google": "^3.0.0",
    "@ai-sdk/mcp": "^1.0.22",
    "@ai-sdk/openai-compatible": "^2.0.31",
    "@ai-sdk/xai": "^3.0.0",
    "@internationalized/date": "^3.11.0",
    "@mirdel/markdown-to-plain": "workspace:*",
    "@mirdel/tts-edge": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@turbodocx/html-to-docx": "^1.20.1",
    "@vscode/ripgrep": "^1.15.9",
    "ai": "^6.0.0",
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.8.0",
    "cheerio": "^1.0.0",
    "esbuild": "^0.25.5",
    "extract-zip": "^2.0.1",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "jsdom": "^26.0.0",
    "marked": "^17.0.1",
    "nanoid": "^5.1.6",
    "npm": "^10.9.4",
    "officeparser": "^6.0.4",
    "sqlite-vec": "0.1.7-alpha.2",
    "tailwindcss": "^4.1.18",
    "tar": "^7.5.13",
    "turndown": "^7.2.4",
    "ws": "^8.19.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@ai-sdk/devtools": "^0.0.15",
    "@ai-sdk/openai": "^3.0.41",
    "@electron/rebuild": "^4.0.3",
    "@formkit/auto-animate": "^0.9.0",
    "@iconify-json/gravity-ui": "^1.2.12",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/iconamoon": "^1.2.2",
    "@iconify-json/lucide": "^1.2.96",
    "@iconify-json/mingcute": "^1.2.7",
    "@iconify-json/proicons": "^1.2.19",
    "@iconify/vue": "^5.0.0",
    "@mirdel/applet-core": "workspace:*",
    "@mirdel/shared": "workspace:*",
    "@nuxt/ui": "^4.4.0",
    "@tanstack/vue-virtual": "3.13.23",
    "@tiptap/core": "^3.18.0",
    "@tiptap/extension-code-block-lowlight": "^3.18.0",
    "@tiptap/extension-list": "^3.18.0",
    "@tiptap/extension-table": "^3.18.0",
    "@tiptap/vue-3": "^3.18.0",
    "@types/jsdom": "^21.1.7",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue-flow/core": "^1.47.3",
    "@vueuse/core": "^14.1.0",
    "@vueuse/motion": "^3.0.3",
    "cross-env": "^7.0.3",
    "electron": "^41.1.0",
    "electron-builder": "^26.0.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.11",
    "katex": "^0.16.27",
    "lowlight": "^3.3.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.12.2",
    "mitt": "^3.0.1",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.4",
    "shiki": "^3.13.0",
    "tsx": "^4.21.0",
    "typed-electron-ipc": "2.0.0-alpha.2",
    "vite": "6.0.7",
    "vitest": "^2.1.8",
    "vue": "^3.5.0",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.5.0",
    "vue-stream-markdown": "^0.6.0"
  }
}
