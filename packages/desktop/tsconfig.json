{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["electron-vite/node"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/*"],
      "@shared": ["../shared/src/index.ts"],
      "@mirdel/markdown-to-plain": ["../markdown-to-plain/src/index.ts"]
    }
  },
  "include": ["src", "test", "electron.vite.config.ts", "vitest.config.ts", "../shared/src", "../markdown-to-plain/src"]
}
