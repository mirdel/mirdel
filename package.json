{
  "name": "mirdel",
  "description": "Mirdel - Next-generation AI workspace",
  "private": true,
  "homepage": "https://www.mirdel.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirdel/mirdel.git"
  },
  "bugs": {
    "url": "https://github.com/mirdel/mirdel/issues"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @mirdel/desktop dev",
    "applet:playground": "pnpm --filter @mirdel/desktop applet:playground",
    "build": "pnpm --filter @mirdel/desktop build",
    "release": "pnpm --filter @mirdel/desktop dist",
    "release:local": "pnpm --filter @mirdel/desktop dist:local",
    "preview": "pnpm --filter @mirdel/desktop preview",
    "check:windows-paths": "node scripts/check-windows-paths.mjs",
    "lint": "pnpm -r lint",
    "test:desktop:data": "pnpm --filter @mirdel/desktop run test:data",
    "test:desktop:store": "pnpm --filter @mirdel/desktop run test:store",
    "test:desktop:service": "pnpm --filter @mirdel/desktop run test:service",
    "test:desktop:router": "pnpm --filter @mirdel/desktop run test:router",
    "test:desktop": "pnpm --filter @mirdel/desktop run test",
    "test": "pnpm -r test",
    "format": "pnpm -r format"
  }
}
